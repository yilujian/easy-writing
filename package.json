{
  "name": "easy-writing",
  "version": "1.0.7",
  "private": true,
  "description": "易创：纯本地、开源的 AI 网文写作桌面软件，支持小说创作、BYOK、自定义提示词与本地数据存储",
  "author": "yilujian",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yilujian/easy-writing.git"
  },
  "homepage": "https://github.com/yilujian/easy-writing#readme",
  "bugs": {
    "url": "https://github.com/yilujian/easy-writing/issues"
  },
  "keywords": [
    "ai-writing",
    "ai-writing-assistant",
    "novel-writing",
    "web-novel",
    "creative-writing",
    "writing-tools",
    "local-first",
    "desktop-app",
    "byok",
    "openai-compatible",
    "tauri",
    "vue3"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --port 6789 --strictPort",
    "dev:desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:desktop:ui": "vite --port 4414 --strictPort",
    "build": "vue-tsc && vite build",
    "build:desktop": "vue-tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint . --ext .vue,.ts,.tsx --ignore-path .gitignore",
    "check:contrast": "node scripts/check-contrast.mjs",
    "lint:fix": "eslint . --ext .vue,.ts,.tsx --fix --ignore-path .gitignore",
    "format": "prettier --write",
    "check": "vue-tsc --noEmit && eslint . --ext .vue,.ts,.tsx --ignore-path .gitignore && vitest run --passWithNoTests",
    "prepare": "simple-git-hooks",
    "test": "vitest run --passWithNoTests",
    "start:local": "node local/server.mjs",
    "test:local": "node --test local/server.test.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@fortawesome/fontawesome-free": "6.7.2",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-sql": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tiptap/core": "^3.11.0",
    "@tiptap/extension-character-count": "^3.10.7",
    "@tiptap/extension-placeholder": "^3.10.7",
    "@tiptap/starter-kit": "^3.10.7",
    "@tiptap/vue-3": "^3.11.0",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "dayjs": "^1.11.11",
    "echarts": "^5.6.0",
    "element-plus": "^2.5.0",
    "markdown-it": "^14.1.0",
    "nprogress": "^0.2.0",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "3.2.3",
    "prosemirror-model": "^1.25.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.3",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/nprogress": "^0.2.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/tsconfig": "^0.5.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^14.12.3",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "sass": "^1.69.5",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~5.3.0",
    "unplugin-auto-import": "^0.17.2",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.1",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^1.8.27"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": "eslint --fix"
  }
}
