        "default": "",
        "required": true
      },
      "intro": {
        "label": "简介",
        "type": "string",
        "default": ""
      },
      "category": {
        "label": "分类",
        "type": "string",
        "default": ""
      },
      "tags": {
        "label": "标签",
        "type": "strings",
        "default": []
      },
      "platform": {
        "label": "目标平台",
        "type": "string",
        "default": ""
      },
      "perspective": {
        "label": "叙事视角",
        "type": "string",
        "default": ""
