        "type": "string",
        "default": null,
        "reference": "worldSettingGroups",
        "nullable": true,
        "required": false
      },
      "type": {
        "label": "类型",
        "type": "number",
        "default": 5,
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5
        ],
        "options": [
          "地理位置",
          "势力宗门",
          "功法技能",
          "物品道具",
          "等级体系",
          "其他"
        ]
      },
      "detail": {
        "label": "详细设定",
        "type": "string",
        "default": "",
