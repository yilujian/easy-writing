        "default": "",
        "required": true
      },
      "summary": {
        "label": "卷纲",
        "type": "string",
        "default": ""
      }
    }
  },
  "outline": {
    "label": "大纲",
    "collection": "outlineNodes",
    "fields": {
      "title": {
        "label": "名称",
        "type": "string",
        "default": "",
        "required": true
      },
      "parentId": {
        "label": "上级大纲",
        "type": "string",
        "default": "0",
        "reference": "outlineNodes",
        "nullable": true,
        "required": false
